---
import PublicLayout from "../layouts/PublicLayout.astro";
import FunnelTracker from "../components/FunnelTracker.astro";
import "../styles/pricing.css";

const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:4000";
---

<PublicLayout
  title="Pricing — ActionAmp"
  description="Start free. Pro is $79.50 per year. Founding membership is $99 once for lifetime Pro, capped at 100 memberships."
  fullWidth
>
  <FunnelTracker event="PRICING_VIEW" surface="pricing" />
  <div class="aa-pricing">
    <header class="aa-pricing-hero">
      <p class="aa-pricing-eyebrow">Simple pricing</p>
      <h1>Start free. Pay when you need more structure.</h1>
      <p>
        Free keeps the focus loop whole. Pro opens up your work and your
        structure. Founding membership is a separate, capped lifetime choice.
      </p>
    </header>

    <section class="aa-pricing-choices" aria-label="Plans">
      <article class="aa-plan aa-plan--free">
        <div class="aa-plan-heading">
          <p class="aa-plan-label">Free <span>Personal plan</span></p>
          <p class="aa-plan-period">Free forever</p>
          <p class="aa-plan-price"><span>$0</span> <strong>forever</strong></p>
          <p class="aa-plan-billing">No renewal. No card required.</p>
          <p class="aa-plan-summary">The full focus loop for one personal scope.</p>
        </div>
        <ul>
          <li>Unlimited capture, tasks, triage, and Next</li>
          <li>Personal (Me) Lens</li>
          <li>3 projects and 1 goal</li>
          <li>Today, Upcoming, and Someday</li>
          <li>30-day Logbook history</li>
        </ul>
        <a class="aa-btn aa-btn--secondary aa-plan-cta" href={`${appUrl}/signup`}>Start free</a>
        <p class="aa-plan-note">Stay Free for as long as it fits.</p>
      </article>

      <article class="aa-plan aa-plan--founding">
        <div class="aa-plan-heading">
          <p class="aa-plan-label">Founding 100 <span>Early adopter membership</span></p>
          <p class="aa-plan-period">One-time payment</p>
          <p class="aa-plan-price"><span>$99</span> <strong>once</strong></p>
          <p class="aa-plan-billing">One payment · no renewal, ever</p>
          <p class="aa-plan-summary">Lifetime Pro. No renewal bill. Capped at 100 memberships.</p>
        </div>
        <ul>
          <li>Everything in Pro, for as long as ActionAmp exists</li>
          <li>No subscription or renewal</li>
          <li>$19.50 more than your first annual Pro year</li>
          <li>Breaks even after about 15 months of annual Pro</li>
          <li>A direct line to the people building the product</li>
        </ul>
        <a class="aa-btn aa-btn--primary aa-plan-cta" href={`${appUrl}/founding-100`}>See Founding membership</a>
        <p class="aa-plan-note">When 100 memberships are claimed, this option retires.</p>
      </article>

      <article class="aa-plan aa-plan--pro">
        <div class="aa-plan-heading">
          <p class="aa-plan-label">Pro <span>Regular plan</span></p>
          <div class="aa-plan-cycle" aria-label="Pro billing period">
            <span data-cycle-label="yearly" class="aa-plan-cycle-label--active">Yearly</span>
            <button
              class="aa-plan-cycle-toggle"
              type="button"
              role="switch"
              aria-checked="false"
              aria-label="Switch to monthly billing"
              data-pro-billing-switch
            ><span></span></button>
            <span data-cycle-label="monthly">Monthly</span>
          </div>
          <p class="aa-plan-period" data-pro-period>Annual subscription</p>
          <p class="aa-plan-price"><span data-pro-price>$79.50</span> <strong data-pro-price-copy>every 12 months</strong></p>
          <p class="aa-plan-billing" data-pro-billing>Billed yearly · renews yearly</p>
          <p class="aa-plan-summary" data-pro-summary>For work, more than a few projects, and the full system.</p>
        </div>
        <ul>
          <li>Everything in Free</li>
          <li>Work, Me, and custom Lenses</li>
          <li>Unlimited projects, goals, and history</li>
          <li>Unlimited devices</li>
          <li>Command palette and Logbook search</li>
          <li>CLI and API access for your terminal tools and agents</li>
        </ul>
        <a class="aa-btn aa-btn--primary aa-plan-cta" href={`${appUrl}/signup`}>Start free, upgrade when ready</a>
        <p class="aa-plan-note" data-pro-note>About $6.63 per month when paid annually. Prefer no renewal? Get a prepaid Pro year for $90.</p>
      </article>
    </section>

    <section class="aa-pricing-explainer" aria-labelledby="pricing-explainer-title">
      <div>
        <p class="aa-pricing-eyebrow">How to choose</p>
        <h2 id="pricing-explainer-title">Choose the shape that fits.</h2>
      </div>
      <dl>
        <div>
          <dt>Just getting focused?</dt>
          <dd>Start Free. The core habit—capture, decide, do—does not expire.</dd>
        </div>
        <div>
          <dt>Ready to run more of life in one place?</dt>
          <dd>Choose annual Pro for the lowest regular price, or monthly Pro if you want to pay month to month.</dd>
        </div>
        <div>
          <dt>Prefer one payment?</dt>
          <dd>Founding is for people who want lifetime Pro and are comfortable with a capped early-membership offer.</dd>
        </div>
      </dl>
    </section>

    <section class="aa-pricing-fine-print" aria-labelledby="pricing-details-title">
      <h2 id="pricing-details-title">The details, plainly.</h2>
      <div class="aa-pricing-details-grid">
        <p><strong>Annual Pro</strong> renews yearly at $79.50. If you do not want renewal, choose the $90 prepaid year instead.</p>
        <p><strong>Founding membership</strong> is not a trial or a discounted first year. It is $99 once for lifetime Pro access, limited to 100 people.</p>
        <p><strong>Nothing is deleted</strong> if a paid plan ends. Your account returns to Free and paid-only structure is kept safely until you upgrade again.</p>
      </div>
    </section>
  </div>
</PublicLayout>

<script>
  const billingSwitch = document.querySelector<HTMLButtonElement>("[data-pro-billing-switch]");

  if (billingSwitch) {
    const plans = {
      yearly: {
        period: "Annual subscription",
        price: "$79.50",
        priceCopy: "every 12 months",
        billing: "Billed yearly · renews yearly",
        summary: "For work, more than a few projects, and the full system.",
        note: "About $6.63 per month when paid annually. Prefer no renewal? Get a prepaid Pro year for $90.",
      },
      monthly: {
        period: "Monthly subscription",
        price: "$12.95",
        priceCopy: "every month",
        billing: "Billed monthly · cancel from billing anytime",
        summary: "Full Pro access, without a yearly commitment.",
        note: "Prefer no renewal? Get a prepaid Pro year for $90.",
      },
    };

    const setBillingPeriod = (period: keyof typeof plans) => {
      const plan = plans[period];
      const isMonthly = period === "monthly";

      billingSwitch.setAttribute("aria-checked", String(isMonthly));
      billingSwitch.setAttribute("aria-label", isMonthly ? "Switch to yearly billing" : "Switch to monthly billing");
      document.querySelectorAll<HTMLElement>("[data-cycle-label]").forEach((label) => {
        label.classList.toggle("aa-plan-cycle-label--active", label.dataset.cycleLabel === period);
      });
      document.querySelector<HTMLElement>("[data-pro-period]")!.textContent = plan.period;
      document.querySelector<HTMLElement>("[data-pro-price]")!.textContent = plan.price;
      document.querySelector<HTMLElement>("[data-pro-price-copy]")!.textContent = plan.priceCopy;
      document.querySelector<HTMLElement>("[data-pro-billing]")!.textContent = plan.billing;
      document.querySelector<HTMLElement>("[data-pro-summary]")!.textContent = plan.summary;
      document.querySelector<HTMLElement>("[data-pro-note]")!.textContent = plan.note;
    };

    billingSwitch.addEventListener("click", () => {
      setBillingPeriod(billingSwitch.getAttribute("aria-checked") === "true" ? "yearly" : "monthly");
    });
  }
</script>
