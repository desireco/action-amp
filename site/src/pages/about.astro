---
// /about — the first ported marketing page. Proof point for the Astro pipeline.
// Markdown content is imported from src/content/about.md; Astro compiles .md
// files as components via the glob loader, so <Content /> renders the HTML.
// We wrap it in .aa-markdown-body so the PublicLayout typography styles apply.
import { getEntry, render } from "astro:content";
import PublicLayout from "../layouts/PublicLayout.astro";

// The glob loader keys entries by file stem (no extension), so id === "about".
const entry = await getEntry("pages", "about");
const { Content } = await render(entry);
const { title, description } = entry.data;
---

<PublicLayout title={title} description={description}>
  <article class="aa-markdown-body">
    <Content />
  </article>
</PublicLayout>
