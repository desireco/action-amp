---
// ShareRow — calm share actions for the end of a blog article.
// Spec: docs/specs/blog-social-meta.md (Done-conditions §Share buttons).
//
// Three actions, no third-party scripts, no widget:
//   - Copy link: clipboard API; button label briefly becomes "Link copied"
//     (~2s), no modal/toast/sound.
//   - Share to X: twitter.com/intent/tweet?url=<canonical>&text=<title>
//   - Share to LinkedIn: linkedin.com/sharing/share-offsite/?url=<canonical>
//
// The canonical URL must be absolute (share intents + crawlers need it).
// Title is URL-encoded for the X intent's text param.
interface Props {
  url: string;   // absolute canonical URL
  title: string; // post title (used as the X intent text)
}
const { url, title } = Astro.props;
const xIntent = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const liIntent = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<div class="aa-share" data-share-url={url}>
  <span class="aa-share-label">Share</span>
  <div class="aa-share-actions">
    <button class="aa-share-btn" type="button" data-share-copy aria-label="Copy link">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M6.5 6.5v-1A1.5 1.5 0 0 1 8 4h4.5A1.5 1.5 0 0 1 14 5.5v4A1.5 1.5 0 0 1 12.5 11h-1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="2" y="6" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
      </svg>
      <span class="aa-share-btn-text">Copy link</span>
    </button>
    <a class="aa-share-btn" href={xIntent} target="_blank" rel="noopener noreferrer" aria-label="Share to X">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M9.2 6.9L13.5 2h-1l-3.7 4.3L5.7 2H2l4.5 6.1L2 13.4h1l4-4.5 3.2 4.5H14L9.2 6.9zM8.1 8.3l-.5-.6L3.6 2.7h1.5l3 4 .5.6 3.8 5.1h-1.5L8.1 8.3z" fill="currentColor"/>
      </svg>
      <span class="aa-share-btn-text">X</span>
    </a>
    <a class="aa-share-btn" href={liIntent} target="_blank" rel="noopener noreferrer" aria-label="Share to LinkedIn">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3.4 5.2v8.5H1.2V5.2h2.2zM2.3 1.4c.7 0 1.3.6 1.3 1.3S3 4 2.3 4 1 3.4 1 2.7s.6-1.3 1.3-1.3zm3.6 12.3V5.2h2.1v1.2c.6-.9 1.5-1.4 2.7-1.4 2 0 3.4 1.3 3.4 3.9v5.2h-2.2V9.3c0-1.2-.4-2-1.5-2-.8 0-1.3.6-1.5 1.2-.1.2-.1.4-.1.7v4.7H5.9z" fill="currentColor"/>
      </svg>
      <span class="aa-share-btn-text">LinkedIn</span>
    </a>
  </div>
</div>

<script is:inline>
  // Copy-link handler. Uses the modern clipboard API with a graceful fallback
  // for older browsers. The button confirms by swapping its label to
  // "Link copied" for ~2s, then reverts. No toast, no modal, no sound —
  // matches the no-guilt-trip tone.
  (function () {
    document.querySelectorAll("[data-share-copy]").forEach(function (btn) {
      var row = btn.closest("[data-share-url]");
      var url = row ? row.getAttribute("data-share-url") : "";
      var label = btn.querySelector(".aa-share-btn-text");
      var originalText = label ? label.textContent : "Copy link";
      btn.addEventListener("click", function () {
        // Success: swap label to "Link copied" for ~2s, calm teal state.
        function done() {
          if (label) label.textContent = "Link copied";
          btn.classList.add("is-copied");
          btn.classList.remove("is-failed");
          setTimeout(function () {
            if (label) label.textContent = originalText;
            btn.classList.remove("is-copied");
          }, 2000);
        }
        // Failure: clear feedback, not a silent no-op. The user needs to know
        // the copy didn't happen so they can copy manually. Calm, not alarming.
        function fail() {
          if (label) label.textContent = "Press ⌘C to copy";
          btn.classList.add("is-failed");
          setTimeout(function () {
            if (label) label.textContent = originalText;
            btn.classList.remove("is-failed");
          }, 3000);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done, fail);
        } else {
          // Legacy fallback for browsers without the async clipboard API.
          var ta = document.createElement("textarea");
          ta.value = url;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
          document.body.removeChild(ta);
          if (ok) { done(); } else { fail(); }
        }
      });
    });
  })();
</script>
