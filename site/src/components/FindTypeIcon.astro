---
// FindTypeIcon — the small monochrome icon + label on a find card.
// Rendering-only (not a topic): watch / read / tool / note.
// Four line icons drawn from the prototype; color comes from currentColor
// (the .aa-find-type class sets it to --aa-text-4).
interface Props {
  type: "watch" | "read" | "tool" | "note";
}
const { type } = Astro.props;
---

{
  type === "watch" && (
    <span class="aa-find-type">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 3h12v10H2z M5 3v10 M11 3v10" stroke="currentColor" stroke-width="1.3" />
      </svg>
      watch
    </span>
  )
}
{
  type === "read" && (
    <span class="aa-find-type">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 2h7l3 3v9H3z M10 2v3h3" stroke="currentColor" stroke-width="1.3" />
      </svg>
      read
    </span>
  )
}
{
  type === "tool" && (
    <span class="aa-find-type">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M8 1l2 5h5l-4 3 1.5 5L8 11l-4.5 3L5 9 1 6h5z"
          stroke="currentColor"
          stroke-width="1.2"
        />
      </svg>
      tool
    </span>
  )
}
{
  type === "note" && (
    <span class="aa-find-type">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 4h10 M3 8h10 M3 12h6"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
        />
      </svg>
      note
    </span>
  )
}
