---
// SiteFooter — the single shared site footer.
//
// Used on every page. Normal flow (never a scroll-snap target). The link set
// matches what every public page already exposes. Styles live in
// styles/site-chrome.css.
import BrandMark from "./BrandMark.astro";

interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
---

<footer class="aa-site-footer">
  <div class="aa-site-footer-inner">
    <a href="/" class="aa-brand" aria-label="ActionAmp home">
      <BrandMark small />
      <span class="aa-brand-name aa-brand-name-sm">ActionAmp</span>
    </a>
    <div class="aa-site-footer-links">
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/roadmap">Roadmap</a>
      <a href="/rss.xml">RSS</a>
      <a href={`${appUrl}/founding-100`}>Founding 100</a>
    </div>
    <div class="aa-site-copy">© 2026 ActionAmp</div>
  </div>
</footer>
