---
// PublicLayout — nav + footer chrome for the marketing site.
// Ported from webapp/src/shared/PublicLayout.tsx.
//
// Link destinations under the subdomain split:
//   - marketing routes (/, /about, /privacy, /terms, /roadmap) → relative
//   - app routes (/founding-100, /login, /signup) → absolute to the app subdomain
// The app origin comes from PUBLIC_APP_URL (dev: localhost:4000, prod: app.actionamp.com).
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StatCounter from "../components/StatCounter.astro";
import "../styles/global.css";
import "../styles/site-chrome.css";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  // Drop the default 720px reading-width constraint on <main> for surfaces that
  // need a wider canvas (the blog index's two-lane grid). Article pages keep it.
  fullWidth?: boolean;
  // --- Social share meta (blog-social-meta) ---
  // Root-absolute path. Every public page gets the branded fallback so a shared
  // link is never text-only; individual posts can still provide their own art.
  ogImage?: string;
  socialDescription?: string;
  twitterCard?: "summary" | "summary_large_image";
  // Article-specific OG tags (LinkedIn rich previews). Only emitted when
  // ogType is "article"; ignored otherwise.
  publishedTime?: string; // ISO 8601
  modifiedTime?: string; // ISO 8601
  author?: string;
  tags?: string[];
}
const {
  title,
  description,
  ogType = "website",
  fullWidth = false,
  ogImage = "/og/share-card.png",
  socialDescription,
  twitterCard = ogType === "article" ? "summary_large_image" : "summary",
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:4000";
const siteUrl = Astro.site ?? "https://actionamp.com";
const canonical = new URL(Astro.url.pathname, siteUrl);
// Social crawlers need absolute URLs for og:image / twitter:image.
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : undefined;
// socialDescription wins for share tags; falls back to the SEO description.
const shareDescription = socialDescription ?? description;
const siteStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl.href,
      name: "ActionAmp",
      description: "A focus app that opens to one task: the next thing that matters.",
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "ActionAmp",
      url: siteUrl.href,
      logo: new URL("/favicon.svg", siteUrl).href,
    },
    {
      "@type": "SoftwareApplication",
      name: "ActionAmp",
      applicationCategory: "ProductivityApplication",
      operatingSystem: "Web",
      url: siteUrl.href,
      image: ogImageUrl,
      description: "A focus app that helps you choose the one task that matters next.",
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0EA5E9" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={siteStructuredData} />
    <!-- RSS feed — the blog publishes here. -->
    <link rel="alternate" type="application/rss+xml" title="ActionAmp — Blog" href="/rss.xml" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {shareDescription && <meta property="og:description" content={shareDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ActionAmp" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:type" content="image/png" />}
    {ogImageUrl && <meta property="og:image:alt" content={title} />}
    {/* Article-specific OG (LinkedIn rich previews) — emitted as a block only
        on article pages. Keeps the head readable and gates once, not four times. */}
    {ogType === "article" && (publishedTime || modifiedTime || author || tags) && (
      <Fragment>
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {author && <meta property="article:author" content={author} />}
        {tags && tags.map((t) => <meta property="article:tag" content={t} />)}
      </Fragment>
    )}
    <!-- Twitter / X -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    {shareDescription && <meta name="twitter:description" content={shareDescription} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={title} />}
  </head>
  <body>
    <StatCounter />
    <div class="aa-public">
      <SiteNav appUrl={appUrl} />

      <main class={`aa-pub-main${fullWidth ? " aa-pub-main--wide" : ""}`}>
        <slot />
      </main>

      <SiteFooter appUrl={appUrl} />
    </div>
  </body>
</html>
