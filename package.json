{
  "name": "action-amp",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web",
    "packages/*"
  ],
  "scripts": {
    "app": "bash scripts/dev.sh",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:e2e": "bash scripts/test-e2e.sh",
    "lint": "oxlint api web packages scripts && bash scripts/check-design-tokens.sh",
    "typecheck": "bun run --filter '*' typecheck",
    "storybook": "cd web && bun run storybook",
    "storybook:build": "cd web && bun run build-storybook"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
