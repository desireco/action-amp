{
  "name": "action-amp",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "api": "bun run --filter '@actionamp/api' dev",
    "web": "bun run --filter '@actionamp/web' dev",
    "dev:api": "bun run --filter '@actionamp/api' dev",
    "dev:web": "bun run --filter '@actionamp/web' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:e2e": "bash scripts/test-e2e.sh",
    "lint": "oxlint api web packages scripts",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
