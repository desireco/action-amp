# Client-side env vars (injected into the browser bundle by Wasp's vite plugin).
# Copy this file to .env.client (gitignored) and adjust for your local setup.
# See webapp/.env.server for server-side env vars.

# The API origin for the browser client. In dev the API (Express) is on :3001
# while the client (Vite) is on :4000, so cross-origin. Prod bakes this in at
# build time.
REACT_APP_API_URL=http://localhost:3001
