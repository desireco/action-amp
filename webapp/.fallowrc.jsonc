{
  "$schema": "https://fallow.tools/schema.json",
  // ── Entry points ────────────────────────────────────────────────────────
  // Wasp wires pages/operations/auth via string config in main.wasp.ts using
  // `import … with { type: "ref" }`. Fallow needs main.wasp.ts named as an
  // entry point or every page/op reads as "unused." Scripts and e2e are also
  // standalone roots. (See webapp/AGENTS.md for the Wasp layout.)
  "entry": [
    "main.wasp.ts",
    "scripts/**/*.mjs",
    "e2e/**/*.ts"
  ],

  // ── Ignore generated / vendored / scratch trees ─────────────────────────
  // .wasp/out is Wasp's generated app + bundled SDK — not source we maintain.
  // The src/auth/google/* files are *intentionally parked*: Google social auth
  // is disabled in main.wasp.ts (imports commented out) and the code is kept
  // for re-enablement. Suppress them so they don't read as dead code.
  "ignorePatterns": [
    ".wasp/**",
    "node_modules/**",
    ".playwright-cli/**",
    "test-results/**",
    "src/auth/google/**"
  ],

  // ── Packages provided by the Wasp runtime / test harness ────────────────
  // These are resolvable at runtime but live in .wasp/out/sdk and aren't in
  // this package.json, so fallow would otherwise flag them as "unlisted."
  // `@wasp.sh/spec` is the Wasp DSL imported in main.wasp.ts via a
  // `file:.wasp/spec/` workspace symlink that fallow can't resolve — also a
  // false positive, suppressed here.
  "ignoreDependencies": [
    "@wasp.sh/api",
    "@wasp.sh/lib-auth",
    "@wasp.sh/spec",
    "@tanstack/react-query",
    "@testing-library/react",
    "express"
  ],

  // ── Dead code: parked features ──────────────────────────────────────────
  // Google social auth is intentionally retained but disabled — the imports
  // in main.wasp.ts are commented out. Suppress until it's flipped back on.
  // (Search main.wasp.ts for "Google social auth — disabled".)
  // Individual files are left to in-file `// fallow-ignore-file` markers so
  // the suppressions travel with the code that knows why it's parked.

  // ResourcePickerSheet is built but not yet wired — the Resources feature
  // (docs/specs/resources-project-owned.md) has spec status `ready` but isn't
  // shipped. Suppress the export + barrel re-export until the feature lands.
  "ignoreExports": [
    { "file": "src/components/ui/ResourcePickerSheet.tsx", "exports": ["ResourcePickerSheet"] },
    { "file": "src/components/ui/index.ts", "exports": ["ResourcePickerSheet"] }
  ],

  "ignoreExportsUsedInFile": false
}
