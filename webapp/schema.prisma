datasource db {
  provider = "postgresql"
  // pi-lens-ignore: P1012
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Use Prisma Schema file to define your entities: https://www.prisma.io/docs/concepts/components/prisma-schema.
// Run `wasp db migrate-dev` in the CLI to create the database tables,
// then run `wasp db studio` to open Prisma Studio and view your db models.
//
// DATA MODEL AUTHORITY: docs/DATA-MODEL.md (v3). Hierarchy:
//   Lens(type=LIFE_AREA) → Goal → Project → {Task, Resource}
//   Lens(type=SIMPLE_LIST) → ListItem
// Key constraints:
//   - Every Goal/Project/standalone Task belongs to exactly one Lens.
//   - Tasks can exist WITHOUT a Project ("General", scoped per Lens).
//   - Projects can exist WITHOUT a Goal (standalone).
//   - Projects contain Tasks + Resources only (NEVER nested Projects).
//   - Every Resource is filed under exactly one Project (no loose resources).
//   - Task defaults: size=M, priority=Normal, status=Someday (triage never auto-clutters Today).

model User {
  id                String  @id @default(uuid())
  fullName          String
  firstName         String
  preferredName     String? // set during onboarding; defaults to firstName when null
  hasSeenOnboarding Boolean @default(false) // true once the user has completed/skipped /welcome (server-side, not localStorage)
  // First-run guidance progresses separately from real work. Existing members
  // default to COMPLETE; new members enter SAMPLE_TASK when they finish /welcome.
  onboardingStage   OnboardingStage @default(COMPLETE)

  // Work-tracker entities
  lenses            Lens[]
  listItems         ListItem[]
  goals             Goal[]
  projects          Project[]
  tasks             Task[]
  taskUpdates       TaskUpdate[] // activity-log entries authored by this user
  taskSessions      TaskSession[] // focus-segment rows authored by this user
  resources         Resource[]
  inboxItems        InboxItem[]
  tags              Tag[]
  feedback          Feedback[]
  pushSubscriptions PushSubscription[]
  apiKeys           ApiKey[] // Personal Access Tokens (CLI auth); deleted with the user
  analyticsSessions AnalyticsSession[]
  analyticsEvents   AnalyticsEvent[]
  loginEvents       LoginEvent[]
  reviews           Review[]

  // ---- Daily Today reminder (Web Push) ----
  // Stored server-side so reminders remain reliable after the installed PWA is
  // closed. Time zone is supplied by the device whenever notification settings
  // are saved; time is local HH:mm.
  dailyReminderEnabled  Boolean   @default(false)
  dailyReminderTime     String    @default("09:00")
  dailyReminderTimeZone String    @default("UTC")
  lastDailyReminderAt   DateTime?

  // ---- Today cap (user-tunable, enforced globally across lenses) ----
  // The committed-for-today list ceiling. Default 5, range 3–12 (enforced in
  // saveTodayCap). Today is universal (WORKFLOW.md §5.11), so this cap applies
  // to the merged cross-lens list, not per-lens.
  todayCap Int @default(5)

  // ---- Focus-session length ----
  // Pomodoro countdown duration selected in Preferences. The UI offers only
  // 25 or 45 minutes; saveFocusSessionMinutes enforces that closed set.
  focusSessionMinutes Int @default(25)

  // ---- Optional review rhythms ----
  // Cadence pages are universal across lenses. Disabling one hides its ritual
  // from navigation; it never deletes completion data or saved reviews.
  todayReviewEnabled Boolean @default(true)
  weekReviewEnabled  Boolean @default(true)
  monthReviewEnabled Boolean @default(true)

  // ---- Billing (Stripe) ----
  // Entitlement state. Mutated ONLY by the Stripe webhook (the source of
  // truth) — never by client actions. See docs/BILLING-INTEGRATION.md.
  payments         Payment[]
  plan             Plan      @default(FREE)
  stripeCustomerId String? // set on first checkout; links to the Stripe customer
  planRenewsAt     DateTime? // null for FREE + FOUNDER (lifetime); set by webhook for PRO

  // ---- Staff / dev bypass ----
  // isAdmin short-circuits the entitlement layer (treated as fully entitled —
  // bypasses every Pro/cap/lens gate). For internal accounts that need to test
  // Pro surfaces without a Stripe checkout. NOT surfaced in any UI; set via the
  // DB or scripts/create-verified-user.mjs --admin. Stripe remains the source of
  // truth for real plan state — this only adds a bypass, never overrides down.
  isAdmin Boolean @default(false)

  // ---- Today rollover (lazy, on app load) ----
  // Tracks the last calendar day the Today→Upcoming rollover ran for this
  // user. getAppData checks it each load: if it's a new day (or null), every
  // incomplete TODAY task flips to UPCOMING and this is stamped. Idempotent
  // within a day. See docs/WORKFLOW.md §2.3.
  lastTodayRolloverAt DateTime?

  // ---- Activity tracking (admin dashboard stats) ----
  // createdAt: when the user signed up (parity with every other model).
  // Backfilled for pre-existing users via scripts/backfill-user-activity.mjs.
  // lastActiveAt: throttled-stamped on app load (getAppData, 15-min window).
  // Null for legacy users until their next app open. Powers the admin
  // dashboard's active-today / 7d / 30d counts.
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?
  lastLoginAt  DateTime?

  // Internal access grant. This never replaces Stripe-owned `plan`; the
  // entitlement resolver chooses it first when present. FRIEND is unlimited
  // internal access but is not a Founding-100 membership.
  manualAccessGrant ManualAccessGrant?
  manualGrantAt     DateTime?

  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([lastLoginAt])
}

// A short-lived, single-use credential for passwordless email login. Codes and
// link tokens are stored as hashes only; the raw values exist only in the email.
model MagicLoginChallenge {
  id         String    @id
  email      String
  codeHash   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// One account may subscribe from several browsers/devices. Endpoints can be
// revoked by their push provider, so send failures remove only that endpoint.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// A user's entitlement tier. FOUNDER = "Founding 100": one-time $99, lifetime,
// capped at 100 spots (FOUNDING_100_CAP in billing/config.ts).
enum Plan {
  FREE
  PRO
  FOUNDER
}

// Our own record of every payment — an audit trail independent of Stripe
// availability, and what we render on the billing page's history table.
// Created by the webhook handler (Phase 2) from verified Stripe events.
model Payment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Preserve Stripe reconciliation history when an administrator permanently
  // deletes a User. Account deletion detaches, rather than erases, payments.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  // Stripe references (for reconciliation / dedupe)
  stripePaymentIntentId   String? @unique
  stripeInvoiceId         String? @unique
  stripeCheckoutSessionId String?

  // What they paid and what it granted
  amount      Int // in cents (Stripe convention)
  currency    String @default("usd")
  plan        Plan // the plan this payment granted
  description String // human label: "Pro Yearly", "Founding 100", etc.

  status PaymentStatus @default(PENDING)
  paidAt DateTime?
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Internal access can grant paid capability without fabricating Stripe billing
// state. FOUNDER consumes a Founding-100 slot; FRIEND deliberately does not.
enum ManualAccessGrant {
  PRO
  FOUNDER
  FRIEND
}

// Opaque admin audit actions. Actor/target ids are stored without relations so
// permanently deleting a user cannot erase operational history.
enum AdminUserActionType {
  GRANT_PRO
  GRANT_FOUNDER
  GRANT_FRIEND
  REMOVE_MANUAL_GRANT
  DELETE_USER
}

model LoginEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  provider  String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

model AdminUserAction {
  id            String              @id @default(uuid())
  createdAt     DateTime            @default(now())
  actorUserId   String
  targetUserId  String?
  action        AdminUserActionType
  previousGrant ManualAccessGrant?
  nextGrant     ManualAccessGrant?

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// ============================================================
// Lens — the top-level scoping switch (Work / Me by default + user-defined on Pro)
// ============================================================
// Defaults seeded for every user: Work + Me. See src/onboarding/operations.ts.
// A Lens is either a structured life area or a direct checklist. Default and
// included are product/entitlement facts, never user-facing lens categories.
// `purpose` is one short line: "what this lens is for."
model Lens {
  id        String   @id @default(uuid())
  name      String // user-facing label (default "Work"/"Me"; user-defined on Pro)
  isDefault Boolean  @default(false) // seeded lenses cannot be deleted or type-converted
  isIncluded Boolean @default(false) // the one Lens available on the Free plan
  type      LensType @default(LIFE_AREA) // behavioral boundary: structured work or direct checklist
  color     String? // identity color key ("indigo", "emerald", …) from the lens palette in tokens.css
  purpose   String? // one short line: what this lens is for
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  goals    Goal[]
  projects Project[]
  tasks    Task[] // standalone tasks directly in this lens
  listItems ListItem[]

  @@unique([userId, name]) // one user can't have two lenses with the same name
}

enum LensType {
  LIFE_AREA
  SIMPLE_LIST
}

// A direct checklist row owned by one SIMPLE_LIST Lens. It intentionally has
// none of Task's planning, focus, hierarchy, or review semantics.
model ListItem {
  id          String    @id @default(uuid())
  text        String
  content     String?   // optional captured body/context; never task planning metadata
  sourceUrl   String?   // optional captured source link
  isDone      Boolean   @default(false)
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lens   Lens   @relation(fields: [lensId], references: [id], onDelete: Cascade)
  lensId String

  attachments ListItemAttachment[]

  @@index([lensId, isDone, order])
}

model ListItemAttachment {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  listItem   ListItem @relation(fields: [listItemId], references: [id], onDelete: Cascade)
  listItemId String
}

// ============================================================
// Goal — the organizing layer (replaces PARA's Areas)
// ============================================================
// Active, outcome-oriented ("Run a 10k"). Projects link to a Goal to express
// WHY they matter. Legacy direct-goal Tasks may exist, but new product flows
// should align goals through Projects.
model Goal {
  id          String    @id @default(uuid())
  name        String
  permalink   String
  description String?
  isDone      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lens   Lens   @relation(fields: [lensId], references: [id], onDelete: Cascade)
  lensId String

  projects Project[]
  tasks    Task[] // legacy direct-goal tasks

  @@unique([userId, name]) // unique goal names per user
  @@unique([userId, permalink])
  @@index([userId, createdAt])
}

// ============================================================
// Project — an outcome needing >1 step
// ============================================================
// Container for Tasks + Resources only. NEVER nested. goalId optional
// (projects can exist without a goal).
model Project {
  id          String    @id @default(uuid())
  name        String
  permalink   String
  description String?
  dueDate     DateTime?
  isDone      Boolean   @default(false)
  // Per-Goal sequence (goal-planning spec §E). Projects with no goal sort by
  // name as before; projects under a goal sort by `order` then name. The first
  // non-done project in this order is surfaced as "Next: <name>".
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  archivedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lens   Lens   @relation(fields: [lensId], references: [id], onDelete: Cascade)
  lensId String

  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalId String?

  tasks     Task[]
  resources Resource[]
  attachments ProjectAttachment[]

  @@unique([userId, permalink])
  @@index([userId, createdAt])
  @@index([userId, archivedAt])
}

// Image attachments carried onto a Project by triage (mirrors
// InboxAttachment / ListItemAttachment / TaskAttachment — same shape, one row
// per image, bytes in `data`). A captured mockup/screenshot triaged into
// "Website redesign" becomes the project's own media.
model ProjectAttachment {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

// ============================================================
// Task — the atomic action (THE focus candidate)
// ============================================================
// projectId optional: a Task with no Project is "General" in its Lens.
// content: Context — longer-form notes / markdown body (what you need to do
//           it). Surfaced in Focus mode + Task detail. Reuses Task.content so
//           no parallel "context" column exists (see docs/specs/task-fields.md).
// outcome:  Outcome — one authorial note captured at completion (what
//           happened), read in Logbook + future Review. Markdown like content.
// updates: an activity log of status notes / progress over time.
model Task {
  id          String    @id @default(uuid())
  description String // the title — what to do
  permalink   String // stable human-readable route key
  content     String? // Context — longer notes / markdown body
  outcome     String? // Outcome — captured at completion, read in Logbook/Review
  isDone      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  // Last write, Prisma-maintained. The Logbook sorts wont-do declines on it
  // ("most recently declined first") — the only record of WHEN a task was
  // declined, since declining neither completes nor archives it.
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime? // non-null = "Now" (in progress); null = "Next" (candidate). Cleared on done/defer/pause.
  // The single harmless sample task used to introduce focus. Other guidance is
  // stage-backed so "capture" and "triage" never become fake task debt.
  isOnboardingSample Boolean @default(false)

  // ---- Focus attributes (read by the Next engine) ----
  priority Priority   @default(NORMAL) // primary sort key
  size     Size       @default(M) // secondary signal + XL break-down nudge
  status   TaskStatus @default(SOMEDAY) // TODAY | UPCOMING | SOMEDAY (pre-filters focus)
  dueDate  DateTime?
  order    Int        @default(0) // manual sort order within a list

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  lens   Lens   @relation(fields: [lensId], references: [id], onDelete: Cascade)
  lensId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalId String?

  tags     Tag[]
  updates  TaskUpdate[] // activity log / progress notes
  sessions TaskSession[] // per-task focus-segment accounting (the clock totals)
  attachments TaskAttachment[]

  @@unique([userId, permalink])
  @@index([userId, createdAt])
  @@index([userId, completedAt])
}

// Primary sort key for the focus engine. Important > Normal > Low.
enum Priority {
  LOW
  NORMAL
  IMPORTANT
}

// Secondary signal + nudge. XL prompts a break-down (→ Project or subtasks).
enum Size {
  S
  M
  L
  XL
}

// The post-triage "where it lives" bucket. INBOX is handled by InboxItem (pre-triage).
// Defaults to SOMEDAY so triage never auto-clutters Today.
//
// WONT_DO — the "I considered this and chose not to do it" state. Distinct from
// done (completed) and from delete (hard-removed at triage): the task stays in
// the DB, drops out of every active list (positive status filters exclude it),
// and surfaces in the Logbook's "Won't do" section, where it can be restored.
// The non-destructive equivalent of delete for post-triage tasks.
enum TaskStatus {
  SOMEDAY
  UPCOMING
  TODAY
  WONT_DO
}

// Image attachments carried onto a Task by triage (mirrors InboxAttachment /
// ListItemAttachment — the same shape, one row per image, bytes in `data`).
// The blobs MOVE here from InboxAttachment when triage dispatches the seed
// item to a task; the InboxItem delete cascades the originals away.
model TaskAttachment {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

// One persistent first-run path, independent from ordinary task state.
enum OnboardingStage {
  SAMPLE_TASK
  CAPTURE
  TRIAGE
  COMPLETE
}

// ============================================================
// TaskUpdate — an activity-log entry on a Task
// ============================================================
// A time-ordered list of progress notes / status updates. Think Linear's
// activity feed or a lightweight changelog per task. Deleted with the task.
//
// `kind` discriminates user-authored notes (NOTE) from system events written
// by server ops (e.g. COMPLETED on focus-mode completion). Default NOTE so
// every legacy row and every plain note reads as a note; one query yields the
// full interleaved timeline. See docs/specs/task-notes-completion-log.md.
model TaskUpdate {
  id        String         @id @default(uuid())
  body      String // the update / note text (markdown ok)
  createdAt DateTime       @default(now())
  kind      TaskUpdateKind @default(NOTE)

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

// Discriminator for the TaskUpdate timeline.
// NOTE = user-authored progress note; COMPLETED = system event from focus-mode
// completion. (STARTED / PAUSED / NOT_DOING belong to the broader
// work-area-merged follow-up — not added here.)
enum TaskUpdateKind {
  NOTE
  COMPLETED
}

// ============================================================
// Review — saved daily/weekly/monthly reflection + stable evidence snapshot
// ============================================================
// Draft reviews read live completion data. Completing a review records the
// visible accomplishments as JSON so later rename/reopen/delete operations do
// not rewrite history. `answers` and `snapshot` are runtime-validated by the
// review operations; JSON keeps cadence-specific prompts versionable without
// sparse columns for every future reflection question.
model Review {
  id          String        @id @default(uuid())
  cadence     ReviewCadence
  periodStart DateTime
  periodEnd   DateTime
  timeZone    String
  answers     Json
  snapshot    Json?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, cadence, periodStart])
  @@index([userId, cadence, periodStart])
}

enum ReviewCadence {
  DAILY
  WEEKLY
  MONTHLY
}

// ============================================================
// TaskSession — a single focused-work segment on a Task
// ============================================================
// Each Start opens a session (endedAt = null); each Pause/Complete closes it
// (endedAt = now). The focus clock's "total" is SUM(endedAt - startedAt) across
// a task's sessions; the live "session" is the elapsed-since on the open one.
// Separate from TaskUpdate so the notes timeline stays narrative while this
// stays pure accounting. Single open session per task is the invariant,
// enforced by close-before-open in startTask/pauseTask/completeTaskFromFocus.
model TaskSession {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  endedAt        DateTime? // null = open/active; set on pause/complete
  plannedMinutes Int? // 25 or 45 for recorded Pomodoro sessions; null on legacy rows
  completed      Boolean   @default(false) // true only when countdown reaches zero

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([taskId, startedAt])
}

// ============================================================
// Feedback — in-app user feedback with app context
// ============================================================
// Submitted from the shell feedback button. Always stored; production also
// emails the configured admin. Context fields are intentionally denormalized so
// feedback remains useful even if a lens is renamed later.
enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  message   String

  // Human-addressable short id for the admin triage surface (the CLI shows +
  // accepts this; the UUID id is the real PK). Crockford base32, `XXXX-XXXX`,
  // minted at submit time via uniqueShortId + enforced unique here. Backfill:
  // existing rows get a generated value in the migration.
  shortId String @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Triage state — managed by admins (via the admin CLI / future admin UI).
  // OPEN is the default for freshly submitted feedback. Existing rows backfill
  // to OPEN on migration (anything not yet triaged is, by definition, open).
  status FeedbackStatus @default(OPEN)

  userName  String?
  userEmail String?

  route     String?
  section   String?
  lensId    String?
  lensName  String?
  lensColor String?
  userAgent String?

  // Diagnostic context — answers the two most common "I can't repro this"
  // questions without a round-trip to the reporter. Both one-liners from the
  // browser, captured once at submit via the shared captureFeedbackContext
  // helper. Optional: old rows + non-browser submits stay valid.
  viewport String? // innerWidth x innerHeight, e.g. "1440x900"
  timezone String? // IANA tz, e.g. "America/Toronto"

  // Soft-delete: an admin can remove a feedback row from the triage surfaces
  // (dashboard table, admin-cli list) without losing the record. When set,
  // every read core filters it out; the row + its audit trail stay in the DB.
  // Deliberately separate from `status` — delete isn't a triage state, it's a
  // removal flag, and folding it into FeedbackStatus would pollute the
  // byStatus counts + the status chips UI.
  deletedAt DateTime?
}

// ============================================================
// Analytics — first-party, admin-only growth events
// ============================================================
// Session stores only an opaque visitor id plus acquisition context. Event
// metadata is typed/validated by analytics/operationsCore.ts; never put task,
// inbox, email, or name content in it. StatCounter remains anonymous/browser
// reporting; this ledger powers the authenticated admin Funnel workspace.
model AnalyticsSession {
  id           String   @id @default(uuid())
  visitorId    String   @unique
  userId       String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  initialPath  String?
  deviceClass  String?
  createdAt    DateTime @default(now())

  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events AnalyticsEvent[]

  @@index([userId])
  @@index([firstSeenAt])
}

model AnalyticsEvent {
  id         String             @id @default(uuid())
  name       AnalyticsEventName
  occurredAt DateTime           @default(now())
  route      String?
  appVersion String?
  metadata   Json?
  sessionId  String
  userId     String?

  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([userId, occurredAt])
}

enum AnalyticsEventName {
  LANDING_VIEW
  PRICING_VIEW
  FOUNDING_VIEW
  SIGNUP_STARTED
  SIGNUP_COMPLETED
  APP_OPENED
  ONBOARDING_COMPLETED
  CAPTURE_CREATED
  TRIAGE_COMPLETED
  FOCUS_STARTED
  TASK_COMPLETED
  CHECKOUT_STARTED
  PAYMENT_CONFIRMED
  LANDING_VARIANT_VIEWED
}

// ============================================================
// Resource — reference material (links + notes), NOT an action
// ============================================================
// Filed under exactly one Project (no loose resources). Resources are shared
// project context — links and notes needed to move that project forward.
model Resource {
  id        String   @id @default(uuid())
  title     String
  url       String?
  notes     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

// ============================================================
// InboxItem — universal inbox, polymorphic pre-triage
// ============================================================
// Raw captured text + the NL parser's guesses. Triage commits these into a
// concrete type (Task/Project/Resource) and DELETES the InboxItem (the
// transformed entity IS the record). See docs/DATA-MODEL.md §9 (decided: delete).
//
// EXCEPTION: "Archive" (I will not do now) does NOT delete — it sets
// status=ARCHIVED. The note survives, recoverable from the Logbook's Archived
// section. Capture is cheap and lossless; people shouldn't lose a note for
// declining to act on it.
model InboxItem {
  id         String          @id @default(uuid())
  text       String // raw captured text
  title      String? // structured title from an Android share (normal capture leaves this null)
  content    String? // structured body from an Android share
  sourceUrl  String? // attached source link from an Android share
  status     InboxItemStatus @default(UNPROCESSED)
  archivedAt DateTime? // set when status → ARCHIVED (the Logbook sorts on this)
  createdAt  DateTime        @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // ---- Parsed-token guesses from the NL parser (nullable; assigned at triage) ----
  parsedDate     DateTime?
  parsedPriority Priority?
  parsedSize     Size?
  parsedTags     String[] // raw tag strings: ["#work"] — grammar v2: @ is time-only, extra # mentions are tags
  parsedProject  String? // first # mention / explicit autocomplete pick (resolved to projectId at triage)
  parsedLens     String? // lens token from `[[name]]` (lowercased); resolved against the user's lenses at triage
  // Explicit optional pre-triage destination, selected by a capture surface.
  // IDs keep same-named projects and lists unambiguous.
  parsedProjectId String?
  parsedLensId    String?
  attachments    InboxAttachment[]
}

// Image files shared from Android. Kept on the InboxItem so capture stays
// self-contained; binary data is capped by the capture operation.
model InboxAttachment {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  inboxItem   InboxItem @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  inboxItemId String
}

enum InboxItemStatus {
  UNPROCESSED
  ARCHIVED // triage "Archive" — kept (not deleted), recoverable from the Logbook
}

model Tag {
  id    String @id @default(uuid())
  name  String
  color String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tasks Task[]

  @@unique([userId, name]) // tags are per-user (two users can share a tag name)
}

// ============================================================
// ApiKey — Personal Access Token for the ActionAmp CLI
// ============================================================
// Issued from the Settings UI (POST /api/pat/issue), pasted once into the CLI,
// sent as `Authorization: Bearer aa_<token>` to /api/cli/* routes. The
// plaintext is shown exactly once at issue time; only `hashedToken` is stored.
// Revocation is by delete (POST /api/pat/revoke). Full-scope, non-expiring v1
// — scoping/expiresAt are deferred (revocation is the safety valve). See
// docs/specs/cli-pat-plumbing.md.
model ApiKey {
  id          String    @id @default(uuid())
  // SHA-256 hash of the plaintext token (deterministic so the inbound Bearer
  // token can be looked up by re-hashing). NOT argon2id — tokens are looked
  // up by hash, which requires determinism; argon2id's random salt makes that
  // impossible. See src/auth/pat.ts for the full reasoning.
  hashedToken String    @unique
  label       String // user-supplied name ("laptop", "ci", …)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime? // stamped on every successful /api/cli/* auth

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}
