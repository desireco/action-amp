{
  "name": "actionamp",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "deploy": "wasp deploy railway deploy action-amp --existing-project-id afda37a6-287f-4c81-b1db-65fc9d2dcb6f --custom-server-url https://api.actionamp.com",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "fallow",
    "email:dev": "email dev --dir src/email/previews",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "E2E_WORKTREE=1 playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "nodemailer": "^9.0.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-email": "^6.6.5",
    "react-markdown": "^9.0.3",
    "react-router": "^7.12.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:.wasp/spec/",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "fallow": "^2.104.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "prisma": "5.19.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^7.0.6",
    "vitest": "^4.0.16"
  }
}
