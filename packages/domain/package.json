    "./inbox": "./src/inbox/index.ts",
    "./simpleLists": "./src/simpleLists/index.ts",
    "./projects": "./src/projects/index.ts",
    "./goals": "./src/goals/index.ts",
    "./search": "./src/search/index.ts",
    "./resources": "./src/resources/index.ts",
    "./lenses": "./src/lenses/index.ts",
    "./logbook": "./src/logbook/index.ts",
    "./notifications": "./src/notifications/index.ts",
