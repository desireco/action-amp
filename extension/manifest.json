{
  "manifest_version": 3,
  "name": "Add to ActionAmp",
  "short_name": "ActionAmp",
  "version": "1.0.0",
  "description": "Capture any page into your ActionAmp inbox — title, link, and selected text, into the same review your phone's share uses.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Add to ActionAmp",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Capture the current page"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
